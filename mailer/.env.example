# Configuration du relais d'envoi — à copier en .env (non versionné).
# Valeurs à relever dans le panneau du prestataire transactionnel retenu.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Adresse d'expédition, sur le domaine vérifié chez le prestataire.
# Aucune boîte n'a besoin d'exister derrière : le visiteur est mis en Reply-To.
# Ne jamais mettre une adresse @bluewin.ch ici, SPF échouerait.
MAIL_FROM=contact@votre-domaine.ch

# Boîte qui reçoit les demandes.
MAIL_TO=rdcambassy@bluewin.ch
